{
    "elasticsearch": {
        "host": "http://127.0.0.1:9200",
        "username": "username",
        "password": "password",
        "verify_certs": false
    },
    "data_indexes": [
        "wbs_resources",
        "wbs_tasks",
        "wbs_info",
        "wbs_calendars"
    ],
    "scenarios": [
        {
            "id": "delayed",
            "name": "starts with delay"
        }
    ],
    "accounts": {
        "creation_mode": {
            "for_all_tasks": false
        }
    },
    "extends": {
        "tasks": [
            {
                "type": "date",
                "id": "Deadline",
                "name": "Deadline"
            }
        ],
        "resources": [
            {
                "type": "text",
                "id": "Type",
                "name": "Type"
            },
            {
                "type": "number",
                "id": "OvertimeCost",
                "name": "Overtime Cost"
            },
            {
                "type": "date",
                "id": "Availability",
                "name": "Availability Date"
            },
            {
                "type": "date",
                "id": "WorkinghoursChange",
                "name": "Workinghours Change"
            },
            {
                "type": "number",
                "id": "BaseCost",
                "name": "Base Cost"
            },
            {
                "type": "number",
                "id": "ActualCost",
                "name": "Actual Cost"
            },
            {
                "type": "text",
                "id": "AccrueAt",
                "name": "Accrue at"
            }
        ]
    },
    "exceptions": {
        "save_logs_in_db": true
    },
    "paths": {
        "tjp_output": "tjp_outputs/project.tjp",
        "templates": "templates/",
        "exports": "exports/"
    }
}