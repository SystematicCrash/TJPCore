# ----------------Project Header-------------
project team_leveling_final "سطح‌بندی تیمی با تقویم‌های فردی" 2025-10-22 +12w {
    outputdir "reports"

# ------------Scenarios-------------
# ------------END-------------
}

# ------------END-------------


# ------------Shifts-------------
# ------------END-------------


# ------------Flags-------------
# ------------END-------------


# ----------------Accounts-------------
account cost "Primary cost account" {
    account resCost "Resources costs" {
        aggregate resources
    }
    account taskCost "Tasks costs" {
        aggregate tasks
    }
}
account rev "Primary revenue account"

# ------------END-------------


# ------------Resources-------------
