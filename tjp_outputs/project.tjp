# ------------Tasks-------------
task task1 "Project Planning" {
    note "Initial planning task."
    scheduling asap
    responsible res1
    shifts shift1
    chargeset planning
    precedes task2
    scheduled
    priority 1000
    effort 120.0d
    effortdone 120.0d
    duration 15.0d
    length 15.0d
    complete 100.0
    minstart 2025-01-01
    maxend 2025-01-20
    minend 2025-01-10
    end 2025-01-15
    charge 5000.0
    maxend 2025-01-20
    flags planning
}

task task2 "Requirements Gathering" {
    note "Gather requirements from stakeholders."
    scheduling asap
    responsible res3
    shifts shift2
    chargeset requirements
    depends task1
