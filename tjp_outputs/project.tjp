project  ""  +0d {

    scenario plan "Planned" {
        scenario delayed "starts with delay"
    }
    extend task {
        date Deadline "tasks deadline"
    }
    extend resource {
        text Type "resource type"
        number OvertimeCost "resource overtime cost"
        date Availability "resources availability date"
        date WorkinghoursChange "resource workinghours change on a specific event"
        number BaseCost "base cost of resource"
        number ActualCost "real cost of resource"
        text AccrueAt "cost allocation of resource"
    }
    outputdir "exports/"
}


shift projectDefaultShift "project default shift" {
}




account projectCosts "costs of project" {
}





textreport projectReports "project gantt chart" {
    formats html
}

resourcereport resourcesReports "resources reports" {
    formats html
}

taskreport taskReports "tasks reports" {
    formats html
}
