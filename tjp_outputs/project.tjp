# ----------------Project Header-------------
project proj2025 "AI Development Project v1.0" 2025-01-01 +364d {
    timezone "UTC"
    currency "USD"
    now 2025-08-20
    workinghours thu 9-17
    scenario base "Baseline Scenario" {
        active yes
    }
    scenario optimistic "Optimistic Scenario" {
        active no
    }
    scenario pessimistic "Pessimistic Scenario" {
        active no
    }
    markdate 2025-06-15
    dailyworkinghours 8.0
    timingresolution 60min
    yearlyworkingdays 250
    weekstartsmonday
}

# ------------END-------------

# ------------Shifts-------------
shift shift1 "Day Shift" {
    replace
    timezone "UTC"
    workinghours mon-fri 9-17
    leaves holiday 2025-12-25
}

shift shift2 "Evening Shift" {
    timezone "UTC"
    workinghours mon-fri 13-21
    shift subshift2_1 "Sub Evening"
}

shift shift3 "Night Shift" {
    timezone "UTC"
    workinghours mon-fri 21-5
}


# ------------END-------------


# ------------Flags-------------
flags
design,
requirements,
manager,
sec,
maint,
arch,
dev,
planning,
train,
audit,
analyst,
qa,
opt,
adj,
deploy,
uat,
mig,
doc,
req
# ------------END-------------


# ----------------Accounts-------------
account acct1 "Project Expenses" {
    aggregate sum
    flag expenses
    account subacct1_1 Salaries
    account subacct1_2 Hardware
    credits 2025-01-01 "Initial funding" 100000.0
    credits 2025-06-01 "Mid-year funding" 50000.0
}

account acct2 "Revenue" {
    aggregate sum
    flag revenue
    credits None "Expected revenue" 200000.0
}


# ------------END-------------


# ------------Resources-------------
resource res1 "Project Manager" {
    rate 150.0
    email pm@example.com
    flag manager
    efficiency 1.0
    shifts shift1
    workinghours mon-fri 9-18
    leaves start 2025-07-01
    vacation Summer Vacation 2025-07-01-2025-07-10
}

resource res2 "Business Analyst" {
    rate 120.0
    email ba@example.com
    managers res1
    flag analyst
    efficiency 0.9
    shifts shift1
}

resource res3 "Requirements Engineer" {
    rate 130.0
    email re@example.com
    managers res1
    flag req
    efficiency 1.0
    shifts shift2
    resource subres3_1 "Assistant RE"
}

resource res4 "Designer" {
    rate 140.0
    email designer@example.com
    managers res1
    flag design
    efficiency 1.0
    shifts shift1
}

resource res5 "Architect" {
    rate 160.0
    email arch@example.com
    managers res1
    flag arch
    efficiency 1.0
    shifts shift1
}

resource res6 "Developer 1" {
    rate 100.0
    email dev1@example.com
    managers res1
    flag dev
    efficiency 0.95
    shifts shift3
}

resource res7 "Developer 2" {
    rate 100.0
    email dev2@example.com
    managers res1
    flag dev
    efficiency 1.0
    shifts shift3
}

resource res8 "Developer 3" {
    rate 100.0
    email dev3@example.com
    managers res1
    flag dev
    efficiency 1.0
    shifts shift3
}

resource res9 "Tester 1" {
    rate 110.0
    email tester1@example.com
    managers res1
    flag qa
    efficiency 1.0
    shifts shift2
}

resource res10 "Tester 2" {
    rate 110.0
    email tester2@example.com
    managers res1
    flag qa
    efficiency 1.0
    shifts shift2
}


# ------------END-------------



# ------------Tasks-------------
task task1 "Project Planning" {
    note "Initial planning task."
    scheduling asap
    responsible res1
    schedulingmode effort
    shifts shift1
    chargeset planning
    precedes task2
    scheduled
    priority 1000
    effort 120.0d
    effortdone 120.0d
    duration 15.0d
    length 15.0d
    complete 100.0
    minstart 2025-01-01
    maxend 2025-01-20
    minend 2025-01-10
    end 2025-01-15
    charge 5000.0
    maxend 2025-01-20
    flag planning
}

task task2 "Requirements Gathering" {
    note "Gather requirements from stakeholders."
    scheduling asap
    responsible res3
    schedulingmode effort
    shifts shift2
    chargeset requirements
    depends task1
    precedes task3
    priority 900
    effort 240.0d
    effortdone 192.0d
    duration 30.0d
    effortleft 48.0d
    length 30.0d
    complete 80.0
    maxstart 2025-01-16
    minstart 2025-01-16
    maxend 2025-02-20
    minend 2025-02-10
    charge 8000.0
    maxend 2025-02-20
    flag requirements
    task subtask2_1 "Interview Users"
    task subtask2_2 "Document Requirements"
}

task task3 "Design Phase" {
    note "System design."
    scheduling alap
    responsible res4
    schedulingmode duration
    chargeset design
    depends task2
    priority 800
    effort 360.0d
    effortdone 180.0d
    duration 45.0d
    effortleft 180.0d
    length 45.0d
    complete 50.0
    charge 10000.0
    flag design
    task subtask3_1 "Architecture Design"
    task subtask3_2 "UI/UX Design"
    task subtask3_3 "Database Design"
}

task task4 "Implementation" {
    note "Code development."
    scheduling asap
    responsible res6
    schedulingmode effort
    chargeset dev
    depends task3
    priority 700
    effort 720.0d
    effortdone 144.0d
    duration 90.0d
    effortleft 576.0d
    length 90.0d
    complete 20.0
    charge 20000.0
    flag dev
    task subtask4_1 "Frontend Development"
    task subtask4_2 "Backend Development"
    task subtask4_3 "Integration"
}

task task5 "Testing" {
    note "Quality assurance."
    scheduling asap
    responsible res9
    schedulingmode effort
    chargeset qa
    depends task4
    priority 600
    effort 480.0d
    duration 60.0d
    effortleft 480.0d
    length 60.0d
    charge 15000.0
    flag qa
    task subtask5_1 "Unit Testing"
    task subtask5_2 "Integration Testing"
    task subtask5_3 "System Testing"
}

task task6 "Deployment" {
    milestone
    note "Final deployment."
    scheduling asap
    responsible res1
    schedulingmode duration
    chargeset deploy
    depends task5
