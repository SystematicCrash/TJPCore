# ----------------Project Header-------------
project proj2025 "Commercial Construction" 2020-08-03 +344d {
    workinghours thu 08:00 - 17:00
    workinghours tue 08:00 - 17:00
    workinghours wed 08:00 - 17:00
    workinghours fri 08:00 - 17:00
    workinghours mon 08:00 - 17:00
    outputdir "reports"
}

# ------------END-------------

# ------------Shifts-------------
# ------------END-------------


# ------------Flags-------------
# ------------END-------------


# ----------------Accounts-------------
account cost "Primary cost account" {
    account resCost "Resources costs" {
        aggregate resources
    }
    account taskCost "Tasks costs" {
        aggregate tasks
    }
}
account rev "Primary revenue account"

# ------------END-------------


# ------------Resources-------------
# ------------END-------------



# ------------Tasks-------------
# ------------END-------------



# ------------Reports-------------
taskreport taskReports "tasksReport" {
    headline "Tasks Table"
    formats csv
    columns
    bsi{title "wbs"}, 
    id{title "id"}, 
    name{title "name"},
    start{title "start"}, 
    end{title "end"},
    duration{title "duration"},
    effort{title "effort"}, 
    effortdone{title "effortDone"},
    effortleft{title "effortLeft"},
    priority{title "priority"},
    responsible{title "responsible"},
    resources{title "resources"},
    status{title "status"},
    activetasks{title "active_sub_tasks"},
    opentasks{title "open_sub_tasks"},
    closedtasks{title "closed_sub_tasks"},
    complete{title "complete"},
    followers{title "flowers"},
    precursors{title "depends_on"},
    pathcriticalness{title "path_criticalness"},
    gauge{title "schedule_gauge"},
    cost { title "total_cost"}

    balance cost rev
    sorttasks tree
    selfcontained yes
}

resourcereport resourceReports "resourceReport" {
    headline "Resources Table"
    formats csv
    columns
    bsi{title "wbs"},
    id{title "id"},
    name{title "name"},
    rate{title "rate"},
    efficiency{title "efficiency"},
    cost{title "cost"},
    duties{title "assigned_tasks"},
    freetime{title "unallocated_work_time"},
    freework{title "unallocated_work_capacity"},
    criticalness,
    fte{title "full_time_equivalent"},
    managers{title "managers"}

    balance cost rev
    sortresources tree
    selfcontained yes
}

# ------------END-------------