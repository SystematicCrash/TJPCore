# ------------END-------------



# ------------Tasks-------------
task project "پروژه ساخت‌وساز (تراز تیمی)" {

    task phase1 "فونداسیون" {

        task concrete "بتن‌ریزی" {
            allocate ali, reza
            depends project.phase1.rebar
            effort 50h
        }


        task excavation "عملیات خاک‌برداری" {
            allocate civil
            effort 80h
        }


        task rebar "نصب میلگرد" {
            allocate civil
            depends project.phase1.excavation
            effort 60h
        }

    }


    task phase2 "سازه" {

        task columns "قالب‌بندی و اجرای ستون‌ها" {
            allocate civil
            depends project.phase1.concrete
            effort 90h
        }


        task mech_fixture "نصب تجهیزات مکانیکی" {
            allocate mech
            depends project.phase2.columns
            effort 100h
        }

    }


    task phase3 "برق‌کشی" {

        task panel "نصب تابلو برق" {
            allocate parsa, narges
            depends project.phase3.wiring
            effort 40h
        }


        task wiring "اجرای سیم‌کشی" {
            allocate elec
            depends project.phase2.mech_fixture
            effort 80h
        }

    }


    task phase4 "نقاشی و پایان‌کار" {

        task inspection "بازرسی نهایی" {
            allocate mech, elec
            depends project.phase4.painting
            effort 40h
        }


        task painting "عملیات نقاشی" {
            allocate fatemeh
            depends project.phase3.panel
            effort 60h
        }

    }

}

# ------------END-------------



# ------------Reports-------------
taskreport taskReports "tasksReport" {
    headline "Tasks Table"
    formats csv
    columns
    bsi{title "wbs"}, 
    id{title "id"}, 
    name{title "name"},
    start{title "start"}, 
    end{title "end"},
    duration{title "duration"},
    effort{title "effort"}, 
    effortdone{title "effortdone"},
    effortleft{title "effortleft"},
    priority{title "priority"},
    responsible{title "responsible"},
    resources{title "resources"},
    status{title "status"},
    inputs{title "prerequisted_milestones"},
    activetasks{title "active_sub_tasks"},
    opentasks{title "open_sub_tasks"},
    closedtasks{title "closed_sub_tasks"},
    complete{title "complete"},
    followers{title "followers"},
    precursors{title "depends_on"},
    criticalness{title "cricitalness"},
    pathcriticalness{title "path_criticalness"},
    gauge{title "schedule_gauge"},
    cost { title "cost"}

    balance cost rev
    sorttasks tree
    selfcontained yes
}

resourcereport resourceReports "resourceReport" {
    headline "Resources Table"
    formats csv
    columns
    bsi{title "wbs"},
    id{title "id"},
    name{title "name"},
    rate{title "rate"},
    efficiency{title "efficiency"},
    cost{title "cost"},
    duties{title "assigned_tasks"},
    freetime{title "unallocated_work_time"},
    freework{title "unallocated_work_capacity"},
    criticalness{title "criticalness"},
    fte{title "full_time_equivalent"},
    managers{title "managers"}

    balance cost rev
    sortresources tree
    selfcontained yes
}

# ------------END-------------