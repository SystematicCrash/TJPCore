# ----------------Project Header-------------
project project_tehran "Tehran Construction Project" 2025-01-01 +546d {
    timezone "Asia/Tehran"
    currency "IRR"
    now 2025-05-26

    scenario plan "Planned" {
        scenario delayed "starts with delay"
    }
    extend task {
        date Deadline "Deadline"
    }
    extend resource {
        text Type "Type"
        number OvertimeCost "Overtime Cost"
        date Availability "Availability Date"
        date WorkinghoursChange "Workinghours Change"
        number BaseCost "Base Cost"
        number ActualCost "Actual Cost"
        text AccrueAt "Accrue at"
    }
    outputdir "exports/csv/"
}

# ------------END-------------

# ------------Shifts-------------
shift projectDefaultShift "project default shift" {
    timezone "Asia/Tehran"
}
# ------------END-------------


# ------------Holidays-------------
# ------------END-------------


# ------------Flags-------------
flags
site_team,
site_cleaning,
site_preparation,
project_management,
foundation,
human,
management,
equipment
# ------------END-------------


# ----------------Accounts-------------
account cost "costs of project" {
    account task_1Costs "Costs of task_1" { aggregate tasks }
    account task_2Costs "Costs of task_2" { aggregate tasks }
    account task_3Costs "Costs of task_3" { aggregate tasks }
    account engineering "Costs of engineering" { aggregate resources }
    account construction "Costs of construction" { aggregate resources }

}
account rev "Revenue"
balance cost rev
# ------------END-------------


# ------------Resources-------------
resource human "resources of type human" {
    flags human
    resource res_engineer "مهندس پروژه" {
        rate 10000.0
        OvertimeCost 15000.0
        AccrueAt "prorated"
        Type "human"
        efficiency 1.0
        leaveallowances annual 2025-01-01 10m
        workinghours sat-wed 08:00-16:00
        leaves annual 2025-08-06
        flags management
        chargeset engineering
    }
    resource res_laborer "کارگر ساختمانی" {
        rate 5000.0
        OvertimeCost 7500.0
        AccrueAt "prorated"
        Type "human"
        efficiency 5.0
        leaveallowances annual 2025-01-01 7m
        workinghours sat-wed 08:00-16:00
        leaves annual 2025-08-06
        flags site_team
        chargeset construction
    }

}
resource equipment "resources of type equipment" {
    flags equipment
    resource res_excavator "بیل مکانیکی" {
        rate 20000.0
        OvertimeCost 30000.0
        AccrueAt "prorated"
        Type "equipment"
        efficiency 2.0
        workinghours sat-wed 08:00-16:00
        leaves annual 2025-08-06
        flags equipment
        chargeset construction
    }

}
# ------------END-------------



# ------------Tasks-------------
    task task_1 "مدیریت پروژه" {
    period 2025-07-01 - 2025-12-28
    allocate res_engineer
    minstart 2025-07-01
    Deadline 2025-12-31
    priority 1
    flags project_management
    chargeset task_1Costs
    charge 5000000.0 onend
    note "مدیریت کلی پروژه شامل برنامه‌ریزی، نظارت، و گزارش‌دهی"

}
    task task_2 "آماده‌سازی سایت" {
    period 2025-07-13 - 2025-08-11
    allocate res_laborer, res_excavator
    depends task_1.1.2
     {
    onend
    }
    minstart 2025-07-13
    Deadline 2025-08-15
    priority 2
    flags site_preparation
    chargeset task_2Costs
    charge 2000000.0 onend
    note "آماده‌سازی زمین برای شروع ساخت"

}
    task task_3 "فونداسیون" {
    period 2025-08-12 - 2025-09-10
    allocate res_engineer, res_laborer
    minstart 2025-08-12
    Deadline 2025-09-15
    priority 3
    flags foundation
    chargeset task_3Costs
    charge 2500000.0 onend
    note "اجرای فونداسیون ساختمان شامل آرماتوربندی، قالب‌بندی و بتن‌ریزی"

}
# ------------END-------------


# ------------Reports-------------
taskreport taskReports "task_report" {
    headline "Tasks Table"
    formats csv
    columns
    bsi{title "wbs"}, id{title "id"}, name{title "name"},
    start{title "start"}, end{title "end"},
    minstart{title "min_start"}, maxstart{title "max_start"},
    minend{title "min_end"}, maxend{title "max_end"},
    Deadline{title "deadline"}, duration{title "duration"},
    effort{title "effort"}, priority{title "priority"},
    children{title "sub_tasks"}, resources{title "resources"},
    flags{title "task_linking"} , complete{title "complete"}
    balance cost rev
    hideresource @all
}

taskreport tasksGanttChart "task_gantt_chart" {
    headline "Tasks Gantt Chart"
    formats csv
    columns id{title "id"}, name, start, end, duration, effort, chart
}

resourcereport resourceReports "resource_report" {
    headline "Resources Table"
    formats csv
    columns
    bsi{title "wbs"}, id{title "id"}, name{title "name"},
    BaseCost{title "base_cost"}, ActualCost{title "actual_cost"},
    rate{title "rate"}, AccrueAt{title "accrue_at"},
    OvertimeCost{title "overtime_cost"}, efficiency{title "efficiency"}, Type{title "type"},
    Availability{title "availability_date"}, flags
    hidetask @all
    sortresources tree
}

accountreport accountReports "cost_report" {
    formats csv
    columns bsi, id{title "id"}, name
}

# ------------END-------------
