# ----------------Project Header-------------
project proj2025 "AI Development Project" 2025-01-01 +10d {
    workinghours thu 9:00 - 17:00
    workinghours tue 9:00 - 17:00
    workinghours wed 9:00 - 17:00
    workinghours sat off
    workinghours fri 9:00 - 17:00
    workinghours mon 9:00 - 17:00
    workinghours sun off
    scenario base "Baseline Scenario" {
        active yes
    }
    scenario optimistic "Optimistic Scenario" {
        active no
    }
    scenario pessimistic "Pessimistic Scenario" {
        active no
    }

}

# ------------END-------------

# ------------Shifts-------------
shift shift2 "Evening Shift" {
    timezone "UTC"
    workinghours thu off
    workinghours tue off
    workinghours wed off
    workinghours sat off
    workinghours fri off
    workinghours mon off
    workinghours sun off
}

shift shift3 "Night Shift" {
    timezone "UTC"
    workinghours thu off
    workinghours tue off
    workinghours wed off
    workinghours sat off
    workinghours fri off
    workinghours mon off
    workinghours sun off
}

shift shift1 "Day Shift" {
    replace
    timezone "UTC"
    workinghours thu off
    workinghours tue off
    workinghours wed off
    workinghours sat off
    workinghours fri off
    workinghours mon off
    workinghours sun off
    leaves annual "Unknown" 2025-01-01 +1d
    vacation "Unknown" 2025-01-01 - 2025-03-04
}


# ------------END-------------


# ------------Flags-------------
flags
audit,
req,
mig,
deploy,
arch,
qa,
dev,
uat,
analyst,
revenue,
opt,
expenses,
design,
sec,
train,
manager,
planning,
doc,
requirements,
maint,
adj
# ------------END-------------


# ----------------Accounts-------------
account acct1 "Project Expenses" {
    aggregate tasks
    flags expenses
    credits 2025-01-01 "Initial funding" 100000.0
    credits 2025-06-01 "Mid-year funding" 50000.0
}

account acct2 "Revenue" {
    aggregate tasks
    flags revenue
    credits 2025-01-01 "Expected revenue" 200000
}


# ------------END-------------


