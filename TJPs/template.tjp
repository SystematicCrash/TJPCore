# Required objects:
# info
# calendar
# tasks
# top_level_resources
# resources


project {{info.project_id}} "{{info.project_name}}" {{info.start_date}} +{{info.project_duration}}d {
    timezone "{{info.timezone}}"
    {% if info.financial_unit == 'ريال' %}
    currency "IRR"
    {% else %}
    currency "info.financial_unit"
    {% endif %}
    now {{info.status_date}}
    scenario plan "Planned"{
        scenario delayed "Starts with delay"
    }
    workinghours {{calendar.working_days}} {{calendar.working_hours}}
}


{% for date in calendar.working_days_exceptions %}
leaves holiday "Exception day" {{date}}
{% endfor %}

{% for flag in flags %}
flags
{% endfor %}

account projectCosts "costs of project"{
    {% for account in accounts %}
    account {{account.id}} "{{account.name}}"
    {% endfor %}
}


{% for top_resource in top_resources %}
resource {{top_resource.id}} "{{top_resource.name}}"{
    {% if top_resource.flags %}
    flags {{','.join(top_resource.flags)}}
    {% endif %}

    {% if top_resource.sub_resources %}
    {% for resource in top_resource.sub_resources %}
    resource {{resource.resource_id}} "{{resource.resource_name}}"{
        {% if resource.base_cost %}
        rate {{resource.base_cost}}
        {% endif %}
        {% if resource.max_units %}
        efficiency {{resource.max_units}}
        {% endif %}
        {% if resource.max_units %}
        efficiency {{resource.max_units}}
        {% endif %}


    }
    {% endfor %}
    {% endif %}
}

{% endfor %}

