# ----------------Project Header-------------
{% if project %}
{% import "project_header.j2" as project_header %}
{{ project_header.header(project, scenario, reports.dir) }}
{% endif %}
# ------------END-------------


# ------------Shifts-------------
{% if shifts %}
{% import "shifts.j2" as shift %}
{{ shift.shifts(shifts) }}
{% endif %}
# ------------END-------------


# ------------Flags-------------
{% if flags %}
flags
{{ flags | join(',\n') }}
{% endif %}
# ------------END-------------


# ----------------Accounts-------------
{% import "accounts.j2" as account %}
{{ account.render_accounts() }}
# ------------END-------------


# ------------Resources-------------
{% if resources %}
{% import "resources.j2" as resource_builder %}
{% for resource in resources %}
{{ resource_builder.render_resource(resource, scenario) }}
{% endfor %}
{% endif %}
# ------------END-------------



# ------------Tasks-------------
{% if tasks %}
{% import "tasks.j2" as task_builder %}
{% for task in tasks %}
{{ task_builder.render_task(task, scenario) }}
{% endfor %}
{% endif %}
# ------------END-------------



# ------------Reports-------------
{% if reports %}
{% import "reports.j2" as reporter %}
{{ reporter.render_reports(reports, scenario) }}
{% endif %}
# ------------END-------------
