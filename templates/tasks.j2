{% macro render_tasks(tasks) %}
{% for task in tasks %}
task {{ task.id }} "{{ task.name }}" {
    {% if task.milestone %}
    milestone
    {% endif %}

    {%- if task.note %}
    note "{{task.note}}"
    {% endif %}

    {%- if task.scheduling %}
    scheduling {{task.scheduling}}
    {% endif %}

    {%- if task.responsible %}
    responsible {{task.responsible}}
    {% endif %}

    {%- if task.shifts %}
    shifts {{ task.shifts | join(', ') }}
    {% endif %}

    {%- if task.chargeset %}
    chargeset {{ task.chargeset | join(', ') }}
    {% endif %}

    {%- if task.depends %}
    depends {{ task.depends | join(', ') }}
    {% endif %}

    {%- if task.precedes %}
    precedes {{ task.precedes | join(', ') }}
    {% endif %}

    {%- if task.scheduled %}
    scheduled
    {% endif %}

    {%- if task.priority %}
    priority {{task.priority}}
    {% endif %}

    {%- if task.effort and not task.duration %}
    effort {{task.effort}}d
    {% endif %}

    {%- if task.effortdone and not task.duration %}
    effortdone {{task.effortdone}}d
    {% endif %}

    {%- if task.duration %}
    duration {{task.duration}}d
    {% endif %}

    {%- if task.effortleft and not task.duration %}
    effortleft {{task.effortleft}}d
    {% endif %}

    {%- if task.length and not task.duration %}
    length {{task.length}}d
    {% endif %}

    {%- if task.complete %}
    complete {{task.complete}}
    {% endif %}

    {%- if task.maxstart %}
    maxstart {{task.maxstart}}
    {% endif %}

    {%- if task.minstart %}
    minstart {{task.minstart}}
    {% endif %}

    {%- if task.maxend %}
    maxend {{task.maxend}}
    {% endif %}

    {%- if task.minend %}
    minend {{task.minend}}
    {% endif %}

    {%- if task.start %}
    start {{task.start}}
    {% endif %}

    {%- if task.end %}
    end {{task.end}}
    {% endif %}

    {%- if task.charge %}
    charge {{task.charge}} onend
    {% endif %}

    {%- if task.maxend %}
    maxend {{task.maxend}}
    {% endif %}

    {%- if task.flags %}
    flags {{ task.flags | join(', ') }}
    {% endif %}

    {%- if task.sub_tasks_objs %}

    {{ render_tasks(task.sub_tasks_objs) | indent(4, false) }}
    {% endif %}
}
{% endfor %}
{% endmacro %}