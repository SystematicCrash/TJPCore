{% macro tasks(tasks) %}
{% for task in tasks %}
task {{ task.task_id }} "{{ task.task_name }}" {
    {%- if task.milestone %}
    milestone
    {% endif %}

    {%- if task.note %}
    note {{task.note}}
    {% endif %}

    {%- if task.scheduling %}
    scheduling {{task.scheduling}}
    {% endif %}

    {%- if task.responsible %}
    responsible {{task.responsible}}
    {% endif %}

    {%- if task.schedulingmode %}
    schedulingmode {{task.schedulingmode}}
    {% endif %}

    {%- if task.shifts %}
    shifts {{task.shifts}}
    {% endif %}

    {%- if task.chargeset %}
    chargeset {{task.chargeset}}
    {% endif %}

    {%- if task.depends %}
    depends {{task.depends}}
    {% endif %}

    {%- if task.precedes %}
    precedes {{task.precedes}}
    {% endif %}

    {%- if task.scheduled %}
    scheduled
    {% endif %}

    {%- if task.priority %}
    priority {{task.priority}}
    {% endif %}

    {%- if task.effort %}
    effort {{task.effort}}d
    {% endif %}

    {%- if task.effortdone %}
    effortdone {{task.effortdone}}d
    {% endif %}

    {%- if task.duration %}
    duration {{task.duration}}d
    {% endif %}

    {%- if task.effortleft %}
    effortleft {{task.effortleft}}d
    {% endif %}

    {%- if task.length %}
    length {{task.length}}d
    {% endif %}

    {%- if task.complete %}
    complete {{task.complete}}
    {% endif %}

    {%- if task.maxstart %}
    maxstart {{task.maxstart}}
    {% endif %}

    {%- if task.minstart %}
    minstart {{task.minstart}}
    {% endif %}

    {%- if task.maxend %}
    maxend {{task.maxend}}
    {% endif %}

    {%- if task.minend %}
    minend {{task.minend}}
    {% endif %}

    {%- if task.start %}
    start {{task.start}}
    {% endif %}

    {%- if task.end %}
    end {{task.end}}
    {% endif %}

    {%- if task.charge %}
    charge {{task.charge}}
    {% endif %}

    {%- if task.maxend %}
    maxend {{task.maxend}}
    {% endif %}

    {%- if task.flags %}
    flag {{ flags | join(', ') }}
    {% endif %}

    {%- for sub_task in task.tasks %}
    task {{sub_task["id"]}} {{sub_task["name"]}}
    {% endfor %}

    {%- if task.period %}
    period {{task.period["start"]}} - {{task.period["end"]}}
    {% endif %}
}
{% endfor %}
{% endmacro %}