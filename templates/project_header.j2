{% macro header(project, scenarios) %}
project {{project.id}} "{{project.name}} v{{project.version}}" {{project.start}} +{{project.duration}}d {
{% if project.timezone %}
    timezone "{{project.timezone}}"
{% endif %}

{%- if project.currency %}
    {% if project.currency == "ریال" %}
    currency "IRR"
    {% else %}
    currency "{{project.currency}}"
    {% endif %}
{% endif %}

{%- if project.now %}
    now {{project.now}}
{% endif %}

{%- if project.workinghours %}
    {% set days = project.workinghours.keys() | list | first %}
    {% set hours = project.workinghours.get(days) %}
    workinghours {{days}} {{hours[0]}}-{{hours[1]}}
{% endif %}

{%- if scenarios %}
    {% for scenario in scenarios %}
    scenario {{scenario.id}} "{{scenario.name}}" {
        {% if scenario.active %}
        active yes
        {% else %}
        active no
        {% endif %}
    }
    {% endfor %}
{% endif %}

{%- if project.markdate %}
    markdate {{project.markdate}}
{% endif %}

{%- if project.dailyworkinghours %}
    dailyworkinghours {{project.dailyworkinghours}}
{% endif %}

{%- if project.timingresolution %}
    timingresolution {{project.timingresolution}}min
{% endif %}

{%- if project.yearlyworkingdays %}
    yearlyworkingdays {{project.yearlyworkingdays}}
{% endif %}

{%- if project.weekstartsmonday %}
    weekstartsmonday
{%- elif project.weekstartssunday %}
    weekstartssunday
{% endif %}

}
{% endmacro %}

