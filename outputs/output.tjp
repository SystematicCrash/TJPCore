holiday "Exception Day"2025-08-02,
holiday "Exception Day"2025-08-03

flags
site_preparation,
foundation,
project_management

account projectCost "Project Cost"{
    account task_1Cost "task_1 Cost"
}

resource res_engineer "مهندس پروژه" {
  workinghours sat-wed 08:00 - 19:00

}
