project project_1 "Commercial Construction Project" 2025-07-01 +180d {
  timezone "Asia/Tehran"
  currency "IRR"
  now 2025-07-01
  workinghours sat-wed 08:00 - 16:00
  scenario plan "Plan" {
    scenario delayed "Delayed"
  }
}

leaves
